[{"number": 1, "globalNumber": 6131, "textArabic": "لَمْ يَكُنِ ٱلَّذِينَ كَفَرُوا۟ مِنْ أَهْلِ ٱلْكِتَٰبِ وَٱلْمُشْرِكِينَ مُنفَكِّينَ حَتَّىٰ تَأْتِيَهُمُ ٱلْبَيِّنَةُ", "translationEnglish": "Those who disbelieved among the People of the Scripture and the polytheists were not to be parted [from misbelief] until there came to them clear evidence -", "translationBangla": "আহলে-কিতাব ও মুশরেকদের মধ্যে যারা কাফের ছিল, তারা প্রত্যাবর্তন করত না যতক্ষণ না তাদের কাছে সুস্পষ্ট প্রমাণ আসত।", "transliterationBangla": "", "tafsirEnglish": "Tafsir (Surah 98, Verse 1): Exegesis and reflection upon this sacred verse.", "tafsirBangla": "তাফসীর (সূরা 98, আয়াত 1): এই বরকতময় আয়াতের শানে নুযূল ও গভীর তাৎপর্য।", "audioUrl": "https://everyayah.com/data/Alafasy_128kbps/098001.mp3", "juz": 30, "sajdah": false, "words": [{"arabic": "لَمْ", "transliteration": "", "english": "لَمْ", "bangla": "لَمْ"}, {"arabic": "يَكُنِ", "transliteration": "", "english": "يَكُنِ", "bangla": "يَكُنِ"}, {"arabic": "ٱلَّذِينَ", "transliteration": "", "english": "ٱلَّذِينَ", "bangla": "ٱلَّذِينَ"}, {"arabic": "كَفَرُوا۟", "transliteration": "", "english": "كَفَرُوا۟", "bangla": "كَفَرُوا۟"}, {"arabic": "مِنْ", "transliteration": "", "english": "مِنْ", "bangla": "مِنْ"}, {"arabic": "أَهْلِ", "transliteration": "", "english": "أَهْلِ", "bangla": "أَهْلِ"}, {"arabic": "ٱلْكِتَٰبِ", "transliteration": "", "english": "ٱلْكِتَٰبِ", "bangla": "ٱلْكِتَٰبِ"}, {"arabic": "وَٱلْمُشْرِكِينَ", "transliteration": "", "english": "وَٱلْمُشْرِكِينَ", "bangla": "وَٱلْمُشْرِكِينَ"}, {"arabic": "مُنفَكِّينَ", "transliteration": "", "english": "مُنفَكِّينَ", "bangla": "مُنفَكِّينَ"}, {"arabic": "حَتَّىٰ", "transliteration": "", "english": "حَتَّىٰ", "bangla": "حَتَّىٰ"}, {"arabic": "تَأْتِيَهُمُ", "transliteration": "", "english": "تَأْتِيَهُمُ", "bangla": "تَأْتِيَهُمُ"}, {"arabic": "ٱلْبَيِّنَةُ", "transliteration": "", "english": "ٱلْبَيِّنَةُ", "bangla": "ٱلْبَيِّنَةُ"}]}, {"number": 2, "globalNumber": 6132, "textArabic": 