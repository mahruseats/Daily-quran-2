[{"number": 1, "globalNumber": 6126, "textArabic": "بِّسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِنَّآ أَنزَلْنَٰهُ فِى لَيْلَةِ ٱلْقَدْرِ", "translationEnglish": "Indeed, We sent the Qur'an down during the Night of Decree.", "translationBangla": "আমি একে নাযিল করেছি শবে-কদরে।", "transliterationBangla": "", "tafsirEnglish": "Tafsir (Surah 97, Verse 1): Exegesis and reflection upon this sacred verse.", "tafsirBangla": "তাফসীর (সূরা 97, আয়াত 1): এই বরকতময় আয়াতের শানে নুযূল ও গভীর তাৎপর্য।", "audioUrl": "https://everyayah.com/data/Alafasy_128kbps/097001.mp3", "juz": 30, "sajdah": false, "words": [{"arabic": "بِّسْمِ", "transliteration": "", "english": "بِّسْمِ", "bangla": "بِّسْمِ"}, {"arabic": "ٱللَّهِ", "transliteration": "", "english": "ٱللَّهِ", "bangla": "ٱللَّهِ"}, {"arabic": "ٱلرَّحْمَٰنِ", "transliteration": "", "english": "ٱلرَّحْمَٰنِ", "bangla": "ٱلرَّحْمَٰنِ"}, {"arabic": "ٱلرَّحِيمِ", "transliteration": "", "english": "ٱلرَّحِيمِ", "bangla": "ٱلرَّحِيمِ"}, {"arabic": "إِنَّآ", "transliteration": "", "english": "إِنَّآ", "bangla": "إِنَّآ"}, {"arabic": "أَنزَلْنَٰهُ", "transliteration": "", "english": "أَنزَلْنَٰهُ", "bangla": "أَنزَلْنَٰهُ"}, {"arabic": "فِى", "transliteration": "", "english": "فِى", "bangla": "فِى"}, {"arabic": "لَيْلَةِ", "transliteration": "", "english": "لَيْلَةِ", "bangla": "لَيْلَةِ"}, {"arabic": "ٱلْقَدْرِ", "transliteration": "", "english": "ٱلْقَدْرِ", "bangla": "ٱلْقَدْرِ"}]}, {"number": 2, "globalNumber": 6127, "textArabic": "وَمَآ أَدْرَىٰكَ مَا لَيْلَةُ ٱلْقَدْرِ", "translationEnglish": "And what can make you know what is the Night of Decree?", "translationBangla": "শবে-কদর সমন্ধে আপনি কি জানেন?", "transliterationBangla": "", "tafsirEnglish": "Tafsir (Surah 97, Verse 2): Exegesis and reflection upon this sacred verse.", "tafsirBangla": "তাফসীর (সূরা 97, আয়াত 2): এই বরকতময় আয়াতের শানে নুযূল ও গভীর তাৎপর্য।", "audioUrl": "https://everyayah.com/data/Alafasy_128kbps/097002.mp3", "juz": 30, "sajdah": false, "words": [{"arabi