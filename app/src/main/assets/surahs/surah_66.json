[{"number": 1, "globalNumber": 5230, "textArabic": "يَٰٓأَيُّهَا ٱلنَّبِىُّ لِمَ تُحَرِّمُ مَآ أَحَلَّ ٱللَّهُ لَكَ ۖ تَبْتَغِى مَرْضَاتَ أَزْوَٰجِكَ ۚ وَٱللَّهُ غَفُورٌۭ رَّحِيمٌۭ", "translationEnglish": "O Prophet, why do you prohibit [yourself from] what Allah has made lawful for you, seeking the approval of your wives? And Allah is Forgiving and Merciful.", "translationBangla": "হে নবী, আল্লাহ আপনার জন্যে যা হালাল করছেন, আপনি আপনার স্ত্রীদেরকে খুশী করার জন্যে তা নিজের জন্যে হারাম করেছেন কেন? আল্লাহ ক্ষমাশীল, দয়াময়।", "transliterationBangla": "", "tafsirEnglish": "Tafsir (Surah 66, Verse 1): Exegesis and reflection upon this sacred verse.", "tafsirBangla": "তাফসীর (সূরা 66, আয়াত 1): এই বরকতময় আয়াতের শানে নুযূল ও গভীর তাৎপর্য।", "audioUrl": "https://everyayah.com/data/Alafasy_128kbps/066001.mp3", "juz": 28, "sajdah": false, "words": [{"arabic": "يَٰٓأَيُّهَا", "transliteration": "", "english": "يَٰٓأَيُّهَا", "bangla": "يَٰٓأَيُّهَا"}, {"arabic": "ٱلنَّبِىُّ", "transliteration": "", "english": "ٱلنَّبِىُّ", "bangla": "ٱلنَّبِىُّ"}, {"arabic": "لِمَ", "transliteration": "", "english": "لِمَ", "bangla": "لِمَ"}, {"arabic": "تُحَرِّمُ", "transliteration": "", "english": "تُحَرِّمُ", "bangla": "تُحَرِّمُ"}, {"arabic": "مَآ", "transliteration": "", "english": "مَآ", "bangla": "مَآ"}, {"arabic": "أَحَلَّ", "transliteration": "", "english": "أَحَلَّ", "bangla": "أَحَلَّ"}, {"arabic": "ٱللَّهُ", "transliteration": "", "english": "ٱللَّهُ", "bangla": "ٱللَّهُ"}, {"arabic": "لَكَ", "transliteration": "", "english": "لَكَ", "bangla": "لَكَ"}, {"arabic": "ۖ", "transliteration": "", "english": "ۖ", "bangla": "ۖ"}, {"arabic": "تَبْتَغِى", "transliteration": "", "english": "تَبْتَغِى", "bangla": "تَبْتَغِى"}, {"arabic": "مَرْضَاتَ", "transliteration": "", "english": "مَرْضَاتَ", "bangla": "مَرْضَاتَ"}, {"arabic": "أَزْوَٰجِكَ", "transliteration": "", "english": "أَزْوَٰجِكَ", "bangla": "أَزْوَٰجِكَ"}, {"arabic": "ۚ", "transliteration": "", "english": "ۚ", "bangla": "ۚ"}, {"arabic": "وَٱللَّهُ", "transliteration": "", "english": "وَٱللَّهُ", "bangla": "وَٱللَّهُ"}, {"arabic": "غَفُورٌۭ", "transliteration": "", "english": "غَفُورٌۭ", "bangla": "غَفُورٌۭ"}, {"arabic": "رَّحِيمٌۭ", "transliteration": "", "english": "رَّحِيمٌۭ", "bangla": "رَّحِيمٌۭ"}]}, {"number": 2, "globalNumber": 5231, "textArabic": "قَدْ فَرَضَ ٱللَّهُ لَكُمْ تَحِلَّةَ أَيْمَٰنِكُمْ ۚ وَٱللَّهُ مَوْلَىٰكُمْ ۖ وَهُوَ ٱلْعَلِيمُ ٱلْحَكِيمُ", "translationEnglish": "Allah has already ordained for you [Muslims] the dissolution of your oaths. And Allah is your protector, and He is the Knowing, the Wise.", "translationBangla": "আল্লাহ তোমাদের জন্যে কসম থেকে অব্যহতি লাভের উপায় নির্ধারণ করে দিয়েছেন। আল্লাহ তোমাদের মালিক। তিনি সর্বজ্ঞ, প্রজ্ঞাময়।", "transliterationBangla": "", "tafsirEnglish": "Tafsir (Surah 66, Verse 2): Exegesis and reflection upon this sacred verse.", "tafsirBangla": "তাফসীর (সূরা 66, আয়াত 2): এই বরকতময় আয়াতের শানে নুযূল ও গভীর তাৎপর্য।", "audioUrl": "https://everyayah.com/data/Alafasy_128kbps/066002.mp3", "juz": 28, "sajdah": false, "words": [{"arabic": "قَدْ", "transliteration": "", "english": "قَدْ", "bangla": "قَدْ"}, {"arabic": "فَرَضَ", "transliteration": "", "english": "فَرَضَ", "bangla": "فَرَضَ"}, {"arabic": "ٱللَّهُ", "transliteration": "", "english": "ٱللَّهُ", "bangla": "ٱللَّهُ"}, {"arabic": "لَكُمْ", "transliteration": "", "english": "لَكُمْ", "bangla": "لَكُمْ"}, {"arabic": "تَحِلَّةَ", "transliteration": "", "english": "تَحِلَّةَ", "bangla": "تَحِلَّةَ"}, {"arabic": "أَيْمَٰنِكُمْ", "transliteration": "", "english": "أَيْمَٰنِكُمْ", "bangla": "أَيْمَٰنِكُمْ"}, {"arabic": "ۚ", "transliteration": "", "english": "ۚ", "bangla": "ۚ"}, {"arabic": "وَٱللَّهُ", "transliteration": "", "english": "وَٱللَّهُ", "bangla": "وَٱللَّهُ"}, {"arabic": "مَوْلَىٰكُمْ", "transliteration": "", "english": "مَوْلَىٰكُمْ", "bangla": "مَوْلَىٰكُمْ"}, {"arabic": "ۖ", "transliteration": "", "english": "ۖ", "bangla": "ۖ"}, {"arabic": "وَهُوَ", "transliteration": "", "english": "وَهُوَ", "bangla": "وَهُوَ"}, {"arabic": "ٱلْعَلِيمُ", "transliteration": "", "english": "ٱلْعَلِيمُ", "bangla": "ٱلْعَلِيمُ"}, {"arabic": "ٱلْحَكِيمُ", "transliteration": "", "english": "ٱلْحَكِيمُ", "bangla": "ٱلْحَكِيمُ"}]}, {"number": 3, "globalNumber": 5232, "textArabic": "وَإِذْ أَسَرَّ ٱلنَّبِىُّ إِلَىٰ بَعْضِ أَزْوَٰجِهِۦ حَدِيثًۭا فَلَمَّا نَبَّأَتْ بِهِۦ وَأَظْهَرَهُ ٱللَّهُ عَلَيْهِ عَرَّفَ بَعْضَهُۥ وَأَعْرَضَ عَنۢ بَعْضٍۢ ۖ فَلَمَّا نَبَّأَهَا بِهِۦ قَالَتْ مَنْ أَنۢبَأَكَ هَٰذَا ۖ قَالَ نَبَّأَنِىَ ٱلْعَلِيمُ ٱلْخَبِيرُ", "translationEnglish": "And [remember] when the Prophet confided to one of his wives a statement; and when she informed [another] of it and Allah showed it to him, he made known part of it and ignored a part. And when he informed her about it, she said, \"Who told you this?\" He said, \"I was informed by the Knowing, the Acquainted.\"", "translationBangla": "যখন নবী তাঁর একজন স্ত্রীর কাছে একটি কথা গোপনে বললেন, অতঃপর স্ত্রী যখন তা বলে দিল এবং আল্লাহ নবীকে তা জানিয়ে দিলেন, তখন নবী সে বিষয়ে স্ত্রীকে কিছু বললেন এবং কিছু বললেন না। নবী যখন তা স্ত্রীকে বললেন, তখন স্ত্রী বললেনঃ কে আপনাকে এ সম্পর্কে অবহিত করল? নবী বললেন,ঃ যিনি সর্বজ্ঞ, ওয়াকিফহাল, তিনি আমাকে অবহিত করেছেন।", "transliterationBangla": "", "tafsirEnglish": "Tafsir (Surah 66, Verse 3): Exegesis and reflection upon this sacred verse.", "tafsirBangla": "তাফসীর (সূরা 66, আয়াত 3): এই বরকতময় আয়াতের শানে নুযূল ও গভীর তাৎপর্য।", "audioUrl": "https://everyayah.com/data/Alafasy_128kbps/066003.mp3", "juz": 28, "sajdah": false, "words": [{"arabic": "وَإِذْ", "transliteration": "", "english": "وَإِذْ", "bangla": "وَإِذْ"}, {"arabic": "أَسَرَّ", "transliteration": "", "english": "أَسَرَّ", "bangla": "أَسَرَّ"}, {"arabic": "ٱلنَّبِىُّ", "transliteration": "", "english": "ٱلنَّبِىُّ", "bangla": "ٱلنَّبِىُّ"}, {"arabic": "إِلَىٰ", "transliteration": "", "english": "إِلَىٰ", "bangla": "إِلَىٰ"}, {"arabic": "بَعْضِ", "transliteration": "", "english": "بَعْضِ", "bangla": "بَعْضِ"}, {